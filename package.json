{
  "name": "unikathek",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter=@repo/database exec prisma generate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "tree": "pnpm --package=tree-cli dlx tree -l 5 --ignore \"node_modules|dist|.turbo|.git\" -o structure.txt -f"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.10",
    "prettier": "^3.6.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.5.5",
    "typescript": "5.8.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.17",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
